# Sonic Mania MiSTer wrapper: menu.cpp patch
#
# Phase 9c addition: hide the "Core" entry on the system OSD page (the page
# the user lands on when they hit the OSD button while Sonic Mania is
# running). 3sx-mister hides this entry too -- it would let the user load
# arbitrary cores out from underneath our running game/wrapper, which is
# not what they want from the in-game menu.
#
# Mechanics: delete the two MenuWrite lines that emit " Core ..." and the
# blank separator row immediately after, and clear bit 0 of `menumask` so
# the cursor cannot navigate to a now-nonexistent entry.
diff --git a/menu.cpp b/menu.cpp
--- a/menu.cpp
+++ b/menu.cpp
@@ -2752,14 +2752,11 @@
 			while(1)
 			{
 				n = 0;
-				menumask = 0x7805d;
+				menumask = 0x7805c;  // Sonic Mania: bit 0 cleared (Core entry hidden)

 				if (!menusub) firstmenu = 0;
 				adjvisible = 0;

-				MenuWrite(n++, " Core                      \x16", menusub == 0, 0);
-				MenuWrite(n++);
-
 				if (cfg.osd_lock[0] && !cfg.osd_lock_time)
 				{
 					MenuWrite(n++, " Lock OSD", menusub == 1, 0);
